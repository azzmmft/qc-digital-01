<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>QC Digital - Edit User</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>


<body class="bg-slate-100 min-h-screen">

    <main class="max-w-xl mx-auto px-4 py-8">

        <a
            href="/admin/users"
            class="text-sm font-bold text-slate-500
                   hover:text-emerald-700"
        >
            ← Kembali
        </a>


        <div
            class="bg-white rounded-2xl shadow-sm
                   border border-slate-200 p-6 mt-5"
        >

            <h1
                class="text-2xl font-black text-slate-900"
            >
                Edit User
            </h1>

            <p class="text-sm text-slate-500 mt-1 mb-6">
                Ubah informasi dan role user.
            </p>


            <% if (error) { %>

                <div
                    class="mb-5 p-3 rounded-lg
                           bg-red-50 border border-red-200
                           text-red-700 text-sm font-semibold"
                >
                    <%= error %>
                </div>

            <% } %>


            <form
                action="/admin/users/<%= editUser.id %>/update"
                method="POST"
                class="space-y-5"
            >

                <div>

                    <label
                        class="block text-xs font-bold
                               uppercase tracking-wider
                               text-slate-700 mb-1.5"
                    >
                        Username
                    </label>

                    <input
                        type="text"
                        name="username"
                        value="<%= editUser.username %>"
                        required
                        maxlength="50"
                        class="w-full h-12 px-3.5
                               bg-slate-50 border border-slate-300
                               rounded-xl text-sm font-semibold
                               focus:outline-none focus:ring-2
                               focus:ring-emerald-500"
                    >

                </div>


                <div>

                    <label
                        class="block text-xs font-bold
                               uppercase tracking-wider
                               text-slate-700 mb-1.5"
                    >
                        Nama
                    </label>

                    <input
                        type="text"
                        name="name"
                        value="<%= editUser.name %>"
                        required
                        maxlength="100"
                        class="w-full h-12 px-3.5
                               bg-slate-50 border border-slate-300
                               rounded-xl text-sm font-semibold
                               focus:outline-none focus:ring-2
                               focus:ring-emerald-500"
                    >

                </div>


                <div>

                    <label
                        class="block text-xs font-bold
                               uppercase tracking-wider
                               text-slate-700 mb-1.5"
                    >
                        Role
                    </label>

                    <select
                        name="role"
                        required
                        class="w-full h-12 px-3.5
                               bg-slate-50 border border-slate-300
                               rounded-xl text-sm font-semibold"
                    >

                        <option
                            value="pengisi"
                            <%= editUser.role === "pengisi"
                                ? "selected"
                                : "" %>
                        >
                            Pengisi
                        </option>

                        <option
                            value="admin"
                            <%= editUser.role === "admin"
                                ? "selected"
                                : "" %>
                        >
                            Admin
                        </option>

                    </select>

                </div>


                <button
                    type="submit"
                    class="w-full h-12
                           bg-emerald-600
                           hover:bg-emerald-700
                           text-white font-bold
                           rounded-xl"
                >
                    Simpan Perubahan
                </button>

            </form>


            <div class="border-t border-slate-200 mt-6 pt-6">

                <h2
                    class="font-black text-slate-900 mb-3"
                >
                    Reset Password
                </h2>


                <form
                    action="/admin/users/<%= editUser.id %>/password"
                    method="POST"
                >

                    <input
                        type="password"
                        name="password"
                        placeholder="Password baru"
                        minlength="6"
                        required
                        class="w-full h-12 px-3.5
                               bg-slate-50
                               border border-slate-300
                               rounded-xl text-sm mb-3"
                    >


                    <button
                        type="submit"
                        class="w-full h-11
                               bg-slate-800
                               hover:bg-slate-900
                               text-white font-bold
                               rounded-xl"
                    >
                        Reset Password
                    </button>

                </form>

            </div>

        </div>

    </main>

</body>

</html>