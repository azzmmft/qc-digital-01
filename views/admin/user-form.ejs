<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>QC Digital - Tambah User</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>


<body class="bg-slate-100 min-h-screen">


    <main class="max-w-xl mx-auto px-4 py-8">

        <a
            href="/admin/users"
            class="text-sm font-bold text-slate-500
                   hover:text-emerald-700"
        >
            ← Kembali
        </a>


        <div
            class="bg-white rounded-2xl shadow-sm
                   border border-slate-200 p-6 mt-5"
        >

            <h1
                class="text-2xl font-black text-slate-900"
            >
                Tambah User
            </h1>

            <p class="text-sm text-slate-500 mt-1 mb-6">
                Buat akun baru untuk Admin atau Pengisi.
            </p>


            <% if (error) { %>

                <div
                    class="mb-5 p-3 rounded-lg
                           bg-red-50 border border-red-200
                           text-red-700 text-sm font-semibold"
                >
                    <%= error %>
                </div>

            <% } %>


            <form
                action="/admin/users/create"
                method="POST"
                class="space-y-5"
            >

                <div>

                    <label
                        class="block text-xs font-bold
                               uppercase tracking-wider
                               text-slate-700 mb-1.5"
                    >
                        Username / NIK
                    </label>

                    <input
                        type="text"
                        name="username"
                        required
                        maxlength="50"
                        class="w-full h-12 px-3.5
                               bg-slate-50 border border-slate-300
                               rounded-xl text-sm font-semibold
                               focus:outline-none focus:ring-2
                               focus:ring-emerald-500"
                    >

                </div>


                <div>

                    <label
                        class="block text-xs font-bold
                               uppercase tracking-wider
                               text-slate-700 mb-1.5"
                    >
                        Nama
                    </label>

                    <input
                        type="text"
                        name="name"
                        required
                        maxlength="100"
                        class="w-full h-12 px-3.5
                               bg-slate-50 border border-slate-300
                               rounded-xl text-sm font-semibold
                               focus:outline-none focus:ring-2
                               focus:ring-emerald-500"
                    >

                </div>


                <div>

                    <label
                        class="block text-xs font-bold
                               uppercase tracking-wider
                               text-slate-700 mb-1.5"
                    >
                        Password
                    </label>

                    <input
                        type="password"
                        name="password"
                        required
                        minlength="6"
                        class="w-full h-12 px-3.5
                               bg-slate-50 border border-slate-300
                               rounded-xl text-sm font-semibold
                               focus:outline-none focus:ring-2
                               focus:ring-emerald-500"
                    >

                </div>


                <div>

                    <label
                        class="block text-xs font-bold
                               uppercase tracking-wider
                               text-slate-700 mb-1.5"
                    >
                        Role
                    </label>

                    <select
                        name="role"
                        required
                        class="w-full h-12 px-3.5
                               bg-slate-50 border border-slate-300
                               rounded-xl text-sm font-semibold
                               focus:outline-none focus:ring-2
                               focus:ring-emerald-500"
                    >

                        <option value="pengisi">
                            Pengisi
                        </option>

                        <option value="admin">
                            Admin
                        </option>

                    </select>

                </div>


                <button
                    type="submit"
                    class="w-full h-12
                           bg-emerald-600
                           hover:bg-emerald-700
                           text-white font-bold
                           rounded-xl shadow-sm
                           transition-all"
                >
                    Simpan User
                </button>

            </form>

        </div>

    </main>

</body>

</html>