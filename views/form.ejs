<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>QC Digital - Form</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        qcGreen: "#178b8e",
                        qcGreenHover: "#137477",

                        qcCardBg: "#eaeaea",
                        qcInputBg: "#dcdcdc",
                        qcInputFocus: "#e2f0d9",

                        qcAlertBg: "#fde3d0",
                        qcAlertBorder: "#f0ad4e",

                        qcShift1: "#2e9d62",
                        qcShift2: "#e5b869",
                        qcShift3: "#d1d5db"
                    }
                }
            }
        }
    </script>
</head>


<body class="bg-slate-100 text-slate-800 font-sans antialiased pb-28">

    <div class="max-w-5xl mx-auto bg-white min-h-screen shadow-md relative">

        <!-- HEADER -->
        <header class="p-4 border-b border-slate-200">

            <!-- Kembali -->
            <button
                type="button"
                onclick="history.back()"
                class="flex items-center text-slate-900 font-bold text-sm mb-3">

                <svg
                    class="w-5 h-5 mr-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24">

                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M15 19l-7-7 7-7" />
                </svg>

                Kembali

            </button>

            <!-- Judul -->
            <div class="text-center my-3">
                <h1
                    class="text-2xl font-black text-slate-900 tracking-tight">

                    <%= selectedProduct %>

                </h1>

                <p class="text-xs font-semibold text-slate-600 mt-0.5">

                    <%= displayDate %> - Line <%= selectedLine %>

                </p>

            </div>

            <!-- SHIFT NAVIGATION -->
            <div class="flex justify-center items-center gap-2 my-4">

                <% for (let shift = 1; shift <= 3; shift++) { %>

                    <% if (shift === currentShift) { %>

                        <!-- SHIFT YANG SEDANG DIPILIH -->
                        <a
                            href="/form?line=<%= selectedLine %>&date=<%= encodeURIComponent(dateISO) %>&shift=<%= shift %>"
                            class="bg-qcShift2 text-slate-900 font-bold text-xs px-3 py-1.5 rounded-md flex items-center gap-1.5 shadow-sm hover:opacity-90 transition-opacity">

                            <span>Shift <%= shift %></span>

                            <svg
                                class="w-3.5 h-3.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24">

                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="3"
                                    d="M5 13l4 4L19 7" />

                            </svg>

                        </a>

                    <% } else { %>

                        <!-- SHIFT LAIN -->
                        <a
                            href="/form?line=<%= selectedLine %>&date=<%= encodeURIComponent(dateISO) %>&shift=<%= shift %>"
                            class="bg-qcShift3 text-slate-700 font-bold text-xs px-3 py-1.5 rounded-md flex items-center gap-1.5 border border-slate-300 hover:bg-slate-200 transition-colors">

                            <span>Shift <%= shift %></span>

                            <span
                                class="w-2.5 h-2.5 rounded-full border border-slate-600 inline-block">
                            </span>

                        </a>

                    <% } %>

                <% } %>

            </div>
            <!-- DOWNLOAD PDF -->
            <div class="mt-3">
                <a
                    href="/form/pdf?line=<%= selectedLine %>&date=<%= encodeURIComponent(dateISO) %>&shift=<%= currentShift %>"
                    class="w-full bg-qcGreen hover:bg-qcGreen/50 text-white font-bold py-2 px-4 rounded-md text-sm flex items-center justify-center gap-2 transition-colors duration-200"
                >
                    <span>Download PDF</span>

                    <svg
                        class="w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414L12 2.586A2 2 0 0010.586 2H6zm5 6a1 1 0 10-2 0v3.586l-1.293-1.293a1 1 0 10-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V8z"
                            clip-rule="evenodd"
                        />
                    </svg>
                </a>
            </div>
        </header>

        <!-- FORM -->
        <form id="qcForm" method="POST" action="/form/save">
            
            <main class="p-4">
                <%
                    const currentShiftData = existingData[currentShift] || {};
                    const isTPH = selectedProduct === "TPH";
                %>
                <!-- MOBILE -->
                <div
                    id="mobile-card-container"
                    class="md:hidden space-y-3">
                    <% for (let row = 1; row <= 24; row++) { %>
                        <div
                            class="bg-qcCardBg rounded-2xl p-3.5 border border-slate-300/60 shadow-sm">
                            <!-- Nomor -->
                            <div
                                class="text-xs font-bold text-slate-700 mb-2">
                                #<%= String(row).padStart(2, "0") %>
                            </div>
                            <div class="grid grid-cols-2 gap-x-3 gap-y-2">
                                <div>
                                    <label
                                        class="block text-center text-xs font-bold text-slate-800 mb-0.5">
                                        AA
                                    </label>
                                    <div class="relative">
                                        <input
                                            type="number"
                                            step="any"
                                            inputmode="decimal"
                                            name="data[<%= row %>][AA]"
                                            data-row="<%= row %>"
                                            data-field="AA"
                                            autocomplete="off"
                                            value="<%= currentShiftData[row]?.AA ?? '' %>"
                                            class="qc-input w-full h-11 text-center text-lg rounded-xl bg-qcInputBg border border-slate-300 font-extrabold text-slate-900 focus:outline-none focus:ring-2 focus:ring-qcGreen transition-colors">
                                        <span
                                            class="qc-error-dot hidden absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 bg-red-600 rounded-full">
                                        </span>
                                    </div>
                                </div>
                                <!-- OT -->
                                <div>
                                    <label
                                        class="block text-center text-xs font-bold text-slate-800 mb-0.5">
                                        OT
                                    </label>
                                    <div class="relative">
                                        <input
                                            type="number"
                                            step="any"
                                            inputmode="decimal"
                                            name="data[<%= row %>][OT]"
                                            data-row="<%= row %>"
                                            data-field="OT"
                                            autocomplete="off"
                                            value="<%= currentShiftData[row]?.OT ?? '' %>"
                                            class="qc-input w-full h-11 text-center text-lg rounded-xl bg-qcInputBg border border-slate-300 font-extrabold text-slate-900 focus:outline-none focus:ring-2 focus:ring-qcGreen transition-colors">
                                        <span
                                            class="qc-error-dot hidden absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 bg-red-600 rounded-full">
                                        </span>
                                    </div>
                                </div>
                                <% if (!isTPH) { %>
                                    <!-- BBT -->
                                    <div>
                                        <label
                                            class="block text-center text-xs font-bold text-slate-800 mb-0.5">
                                            BBT
                                        </label>
                                        <div class="relative">
                                            <input
                                                type="number"
                                                step="any"
                                                inputmode="decimal"
                                                name="data[<%= row %>][BBT]"
                                                data-row="<%= row %>"
                                                data-field="BBT"
                                                autocomplete="off"
                                                value="<%= currentShiftData[row]?.BBT ?? '' %>"
                                                class="qc-input w-full h-11 text-center text-lg rounded-xl bg-qcInputBg border border-slate-300 font-extrabold text-slate-900 focus:outline-none focus:ring-2 focus:ring-qcGreen transition-colors">
                                            <span
                                                class="qc-error-dot hidden absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 bg-red-600 rounded-full">
                                            </span>
                                        </div>
                                    </div>

                                    <!-- N2 -->
                                    <div>
                                        <label
                                            class="block text-center text-xs font-bold text-slate-800 mb-0.5">
                                            N2
                                        </label>
                                        <div class="relative">
                                            <input
                                                type="number"
                                                step="any"
                                                inputmode="decimal"
                                                name="data[<%= row %>][N2]"
                                                data-row="<%= row %>"
                                                data-field="N2"
                                                autocomplete="off"
                                                value="<%= currentShiftData[row]?.N2 ?? '' %>"
                                                class="qc-input w-full h-11 text-center text-lg rounded-xl bg-qcInputBg border border-slate-300 font-extrabold text-slate-900 focus:outline-none focus:ring-2 focus:ring-qcGreen transition-colors">
                                            <span
                                                class="qc-error-dot hidden absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 bg-red-600 rounded-full">
                                            </span>
                                        </div>
                                    </div>
                                <% } %>
                                <% if (isTPH) { %>
                                    <!-- AA* / RETEST AA -->
                                    <div>
                                        <label
                                            class="block text-center text-xs font-bold text-slate-800 mb-0.5">
                                            AA*
                                        </label>

                                        <div class="relative">
                                            <input
                                                type="number"
                                                step="any"
                                                inputmode="decimal"
                                                name="data[<%= row %>][AA_RETEST]"
                                                data-row="<%= row %>"
                                                data-field="AA_RETEST"
                                                autocomplete="off"
                                                value="<%= currentShiftData[row]?.AA_RETEST ?? '' %>"
                                                disabled
                                                class="qc-input w-full h-11 text-center text-lg rounded-xl bg-qcInputBg border border-slate-300 font-extrabold text-slate-900 focus:outline-none focus:ring-2 focus:ring-qcGreen transition-colors">

                                            <span
                                                class="qc-error-dot hidden absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 bg-red-600 rounded-full">
                                            </span>
                                        </div>
                                    </div>


                                    <!-- OT* / RETEST OT -->
                                    <div>
                                        <label
                                            class="block text-center text-xs font-bold text-slate-800 mb-0.5">
                                            OT*
                                        </label>

                                        <div class="relative">
                                            <input
                                                type="number"
                                                step="any"
                                                inputmode="decimal"
                                                name="data[<%= row %>][OT_RETEST]"
                                                data-row="<%= row %>"
                                                data-field="OT_RETEST"
                                                autocomplete="off"
                                                value="<%= currentShiftData[row]?.OT_RETEST ?? '' %>"
                                                disabled
                                                class="qc-input w-full h-11 text-center text-lg rounded-xl bg-qcInputBg border border-slate-300 font-extrabold text-slate-900 focus:outline-none focus:ring-2 focus:ring-qcGreen transition-colors">

                                            <span
                                                class="qc-error-dot hidden absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 bg-red-600 rounded-full">
                                            </span>
                                        </div>
                                    </div>

                                <% } %>
                             </div>
                        </div>
                    <% } %>
                </div>

                <!-- DESKTOP TABLE -->
                <div
                    id="desktop-table-container"
                    class="hidden md:block overflow-x-auto border border-slate-200 rounded-lg shadow-sm">
                    <table
                        class="w-full text-center border-collapse">
                        <thead>
                            <tr
                                class="bg-slate-200 text-slate-800 text-xs font-bold uppercase tracking-wider">
                                <th class="py-3 px-3 border-b border-slate-300">
                                    No
                                </th>

                                <th class="py-3 px-3 border-b border-slate-300">
                                    AA
                                </th>

                                <th class="py-3 px-3 border-b border-slate-300">
                                    OT
                                </th>

                                <% if (selectedProduct === "TPH") { %>

                                    <th class="py-3 px-3 border-b border-slate-300">
                                        AA*
                                    </th>

                                    <th class="py-3 px-3 border-b border-slate-300">
                                        OT*
                                    </th>

                                <% } else { %>

                                    <th class="py-3 px-3 border-b border-slate-300">
                                        BBT
                                    </th>

                                    <th class="py-3 px-3 border-b border-slate-300">
                                        N2
                                    </th>

                                <% } %>
                            </tr>
                        </thead>
                        <tbody class="text-sm font-bold">
                            <%
                                const formFields = selectedProduct === "TPH"
                                    ? ["AA", "OT", "AA_RETEST", "OT_RETEST"]
                                    : ["AA", "OT", "BBT", "N2"];
                            %>

                            <% for (let row = 1; row <= 24; row++) { %>

                                <tr class="border-b border-slate-200 hover:bg-slate-50">

                                    <td class="py-2 px-3 text-slate-500 font-mono">
                                        <%= String(row).padStart(2, "0") %>
                                    </td>

                                    <% formFields.forEach(field => { %>

                                        <%
                                            const isRetest =
                                                field === "AA_RETEST" ||
                                                field === "OT_RETEST";
                                        %>

                                        <td class="py-2 px-2">

                                            <div class="relative">

                                                <input
                                                    type="number"
                                                    step="any"
                                                    inputmode="decimal"
                                                    name="data[<%= row %>][<%= field %>]"
                                                    data-row="<%= row %>"
                                                    data-field="<%= field %>"
                                                    autocomplete="off"
                                                    value="<%= currentShiftData[row]?.[field] ?? '' %>"
                                                    <%= isRetest ? "disabled" : "" %>
                                                    class="qc-input w-full h-9 text-center rounded-lg bg-qcInputBg border border-slate-300 font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-qcGreen">

                                                <span
                                                    class="qc-error-dot hidden absolute left-2 top-1/2 -translate-y-1/2 w-2.5 h-2.5 bg-red-600 rounded-full">
                                                </span>

                                            </div>

                                        </td>

                                    <% }) %>

                                </tr>

                            <% } %>

                        </tbody>
                    </table>
                </div>
            </main>
            <!-- HIDDEN METADATA -->
            <input
                type="hidden"
                name="line"
                value="<%= selectedLine %>">
            <input
                type="hidden"
                name="date"
                value="<%= dateISO %>">>
            <input
                type="hidden"
                name="product"
                value="<%= selectedProduct %>">
            <input
                type="hidden"
                name="shift"
                value="<%= currentShift %>">
            <!-- STICKY SAVE BUTTON -->
            <div
                class="fixed bottom-0 left-0 right-0 z-30 p-3 bg-white/85 backdrop-blur-sm border-t border-slate-200 flex justify-center">
                <div class="w-full max-w-md">
                    <button
                        id="saveButton"
                        type="submit"
                        class="w-full bg-qcGreen hover:bg-qcGreenHover text-white font-bold py-3 px-4 rounded-xl text-sm shadow-md transition-all active:scale-[0.99]">
                        <span id="progressText">
                            0 / 24 row terisi
                        </span>
                        <span>
                            [ SIMPAN SHIFT <%= currentShift %> ]
                        </span>
                    </button>
                </div>
            </div>
        </form>
    </div>
    <!-- JAVASCRIPT -->
    <script>
        /*
         * Standard QC sementara.
         *
         * Nanti sebaiknya data ini berasal dari qcStandards.js
         * melalui backend, bukan hard-code di frontend.
         */
        const qcStandard = {
            LM: {
                AA: {
                    min: 200,
                    max: 230
                },

                OT: {
                    min: 7,
                    max: 13
                },

                BBT: {
                    min: 6,
                    max: 12
                },

                N2: {
                    min: 0.4,
                    max: 0.6
                }
            },

            TPH: {
                AA: {
                    min: 320,
                    max: 370
                },

                OT: {
                    min: 8,
                    max: 11
                }

                // BBT dan N2 tidak memiliki standard
            }

        };


        const selectedLine = "<%= selectedLine %>";

        const lineType = {
            "1": "TPH",
            "2": "TPH",
            "3": "LM",
            "4": "TPH",
            "10": "LM"
        };

        const productType = lineType[selectedLine];

        console.log("LINE:", selectedLine);
        console.log("PRODUCT TYPE:", productType);


        const inputs =
            document.querySelectorAll(".qc-input");


        /*
         * Cek apakah nilai berada dalam standard.
         */

        function isOutOfStandard(field, value) {

            const standard =
                qcStandard[productType]?.[field];


            /*
             * Kalau tidak ada standard,
             * tidak dianggap error.
             *
             * Contoh:
             * BBT/N2 pada TPH.
             */

            if (!standard) {
                return false;
            }


            if (value === "") {
                return false;
            }


            const number =
                Number(value);


            if (Number.isNaN(number)) {
                return false;
            }


            return (
                number < standard.min ||
                number > standard.max
            );

        }
        function updateRetestState(row) {

            // Hanya berlaku untuk TPH
            if (productType !== "TPH") {
                return;
            }


            // Ambil semua input AA pada row tersebut
            const aaInputs = document.querySelectorAll(
                `.qc-input[data-row="${row}"][data-field="AA"]`
            );

            // Ambil semua input OT pada row tersebut
            const otInputs = document.querySelectorAll(
                `.qc-input[data-row="${row}"][data-field="OT"]`
            );

            // Ambil semua input AA*
            const aaRetestInputs = document.querySelectorAll(
                `.qc-input[data-row="${row}"][data-field="AA_RETEST"]`
            );

            // Ambil semua input OT*
            const otRetestInputs = document.querySelectorAll(
                `.qc-input[data-row="${row}"][data-field="OT_RETEST"]`
            );


            // Kalau input tidak ditemukan, hentikan
            if (
                aaInputs.length === 0 ||
                otInputs.length === 0 ||
                aaRetestInputs.length === 0 ||
                otRetestInputs.length === 0
            ) {
                return;
            }


            /*
            * Ambil nilai AA dan OT.
            *
            * Karena mobile dan desktop berisi
            * data yang sama, kita cukup mengambil
            * nilai dari input pertama.
            */

            const aaValue = aaInputs[0].value;
            const otValue = otInputs[0].value;


            // =========================
            // AA → AA*
            // =========================

            const aaOut =
                isOutOfStandard("AA", aaValue);

            aaRetestInputs.forEach(input => {

                input.disabled = !aaOut;

            });


            // =========================
            // OT → OT*
            // =========================

            const otOut =
                isOutOfStandard("OT", otValue);

            otRetestInputs.forEach(input => {

                input.disabled = !otOut;

            });

        }

        /*
         * Update tampilan input.
         */

        function validateInput(input) {

            const value =
                input.value;

            const field =
                input.dataset.field;


            const wrapper =
                input.parentElement;


            const errorDot =
                wrapper.querySelector(".qc-error-dot");


            const out =
                isOutOfStandard(field, value);


            if (out) {

                input.classList.remove(
                    "bg-qcInputBg",
                    "border-slate-300"
                );

                input.classList.add(
                    "bg-qcAlertBg",
                    "border-qcAlertBorder"
                );


                errorDot.classList.remove(
                    "hidden"
                );

            } else {

                input.classList.remove(
                    "bg-qcAlertBg",
                    "border-qcAlertBorder"
                );

                input.classList.add(
                    "bg-qcInputBg",
                    "border-slate-300"
                );


                errorDot.classList.add(
                    "hidden"
                );

            }
            // Update status AA*/OT* untuk TPH
            if (
                productType === "TPH" &&
                (field === "AA" || field === "OT")
            ) {
                updateRetestState(
                    input.dataset.row
                );
            }

        }



        /*
         * Hitung jumlah row yang sudah diisi.
         *
         * Sebuah row dianggap terisi jika
         * minimal salah satu inputnya memiliki nilai.
         */

        function updateProgress() {

            const rows =
                new Set();


            inputs.forEach(input => {

                if (input.value.trim() !== "") {

                    rows.add(
                        input.dataset.row
                    );

                }

            });


            const count =
                rows.size;


            const progressText =
                document.getElementById(
                    "progressText"
                );


            progressText.textContent =
                `${count} / 24 row terisi`;

        }



        /*
         * Event input.
         */

        inputs.forEach(input => {

            validateInput(input);

            input.addEventListener(
                "input",
                () => {

                    validateInput(input);

                    updateProgress();

                }
            );

        });



        /*
         * Initial state.
         */

        updateProgress();

        // =====================================================
        // PASTIKAN HANYA INPUT YANG TERLIHAT YANG DI-SUBMIT
        // =====================================================

        const qcForm = document.getElementById("qcForm");

        qcForm.addEventListener("submit", function () {

            const isMobile =
                window.matchMedia("(max-width: 767px)").matches;

            const mobileContainer =
                document.getElementById("mobile-card-container");

            const desktopContainer =
                document.getElementById("desktop-table-container");

            if (isMobile) {

                // HP:
                // Aktifkan input mobile
                // Nonaktifkan input desktop

                mobileContainer
                    .querySelectorAll("input")
                    .forEach(input => {
                        input.disabled = false;
                    });

                desktopContainer
                    .querySelectorAll("input")
                    .forEach(input => {
                        input.disabled = true;
                    });

            } else {

                // DESKTOP:
                // Nonaktifkan input mobile
                // Aktifkan input desktop

                mobileContainer
                    .querySelectorAll("input")
                    .forEach(input => {
                        input.disabled = true;
                    });

                desktopContainer
                    .querySelectorAll("input")
                    .forEach(input => {
                        input.disabled = false;
                    });

            }

        });

    </script>

</body>

</html>