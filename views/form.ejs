<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>QC Digital - Form</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        qcGreen: "#178b8e",
                        qcGreenHover: "#137477",

                        qcCardBg: "#eaeaea",
                        qcInputBg: "#dcdcdc",
                        qcInputFocus: "#e2f0d9",

                        qcAlertBg: "#fde3d0",
                        qcAlertBorder: "#f0ad4e",

                        qcShift1: "#2e9d62",
                        qcShift2: "#e5b869",
                        qcShift3: "#d1d5db"
                    }
                }
            }
        }
    </script>
</head>


<body class="bg-slate-100 text-slate-800 font-sans antialiased pb-28">

    <div class="max-w-5xl mx-auto bg-white min-h-screen shadow-md relative">

        <!-- HEADER -->
        <header class="p-4 border-b border-slate-200">

            <!-- Kembali -->
            <button
                type="button"
                onclick="history.back()"
                class="flex items-center text-slate-900 font-bold text-sm mb-3">

                <svg
                    class="w-5 h-5 mr-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24">

                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M15 19l-7-7 7-7" />
                </svg>

                Kembali

            </button>

            <!-- Judul -->
            <div class="text-center my-3">
                <h1
                    class="text-2xl font-black text-slate-900 tracking-tight">

                    <%= selectedProduct %>

                </h1>

                <p class="text-xs font-semibold text-slate-600 mt-0.5">

                    <%= displayDate %> - Line <%= selectedLine %>

                </p>

            </div>

            <!-- SHIFT NAVIGATION -->
            <div class="flex justify-center items-center gap-2 my-4">

                <% for (let shift = 1; shift <= 3; shift++) { %>

                    <%
                        const isCurrent =
                            shift === currentShift;

                        const isComplete =
                            shiftStatus?.[shift] === true;
                    %>

                    <a
                        href="/form?line=<%= selectedLine %>&date=<%= encodeURIComponent(dateISO) %>&shift=<%= shift %>"
                        class="
                            font-bold text-xs px-3 py-1.5 rounded-md
                            flex items-center gap-1.5
                            transition-colors
                            <%= isCurrent
                                ? 'bg-qcShift2 text-slate-900 shadow-sm'
                                : isComplete
                                    ? 'bg-qcShift1 text-white'
                                    : 'bg-qcShift3 text-slate-700 border border-slate-300'
                            %>
                        "
                    >

                        <span>
                            Shift <%= shift %>
                        </span>

                        <% if (isComplete) { %>

                            <!-- CHECK -->
                            <svg
                                class="w-3.5 h-3.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="3"
                                    d="M5 13l4 4L19 7"
                                />
                            </svg>

                        <% } else { %>

                            <!-- BULATAN -->
                            <span
                                class="w-2.5 h-2.5 rounded-full border border-current inline-block">
                            </span>

                        <% } %>

                    </a>

                <% } %>

            </div>
            <!-- DOWNLOAD PDF -->
            <div class="mt-3">
                <a
                    href="/form/pdf?line=<%= selectedLine %>&date=<%= encodeURIComponent(dateISO) %>&shift=<%= currentShift %>"
                    class="w-full bg-qcGreen hover:bg-qcGreen/50 text-white font-bold py-2 px-4 rounded-md text-sm flex items-center justify-center gap-2 transition-colors duration-200"
                >
                    <span>Download PDF</span>

                    <svg
                        class="w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414L12 2.586A2 2 0 0010.586 2H6zm5 6a1 1 0 10-2 0v3.586l-1.293-1.293a1 1 0 10-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V8z"
                            clip-rule="evenodd"
                        />
                    </svg>
                </a>
            </div>
        </header>

        <!-- FORM -->
        <form id="qcForm" method="POST" action="/form/save">
            <!-- NAMA PEMERIKSA -->
            <div class="px-4 mb-4">
                <label
                    for="examinerName"
                    class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5"
                >
                    Nama Pemeriksa
                </label>

                <input
                    type="text"
                    id="examinerName"
                    name="examinerName"
                    value="<%= examinerName || '' %>"
                    autocomplete="name"
                    placeholder="Masukkan nama pemeriksa"
                    class="w-full h-11 px-3.5 bg-slate-50 border border-slate-300 rounded-xl text-sm font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-qcGreen focus:border-qcGreen focus:bg-white transition-colors"
                >
            </div>
            
            <main class="p-4">
                <%
                    const currentShiftData = existingData[currentShift] || {};
                    const isTPH = selectedProduct === "TPH";

                    const rowCount =
                        String(selectedLine) === "4"
                            ? 24
                            : 20;
                %>
                <!-- MOBILE -->
                <div
                    id="mobile-card-container"
                    class="md:hidden space-y-3">
                    <% for (let row = 1; row <= rowCount; row++) { %>
                        <div
                            class="qc-row-card bg-qcCardBg rounded-2xl p-3.5 border border-slate-300/60 shadow-sm transition-all duration-200"
                            data-row-card="<%= row %>">
                            <!-- Nomor -->
                            <div
                                class="text-xs font-bold text-slate-700 mb-2">
                                #<%= String(row).padStart(2, "0") %>
                            </div>
                            <!-- SEQUENTIAL ALERT -->
                            <div
                                class="row-alert hidden mb-2 px-3 py-2 rounded-xl
                                    bg-qcAlertBg border border-qcAlertBorder
                                    text-xs font-bold text-amber-800">
                            </div>
                            <div class="grid grid-cols-2 gap-x-3 gap-y-2">
                                <div>
                                    <label
                                        class="block text-center text-xs font-bold text-slate-800 mb-0.5">
                                        AA
                                    </label>
                                    <div class="relative">
                                        <input
                                            type="number"
                                            step="any"
                                            inputmode="decimal"
                                            name="data[<%= row %>][AA]"
                                            data-row="<%= row %>"
                                            data-field="AA"
                                            autocomplete="off"
                                            value="<%= currentShiftData[row]?.AA ?? '' %>"
                                            class="qc-input w-full h-11 text-center text-lg rounded-xl bg-qcInputBg border border-slate-300 font-extrabold text-slate-900 focus:outline-none focus:ring-2 focus:ring-qcGreen transition-colors">
                                        <span
                                            class="qc-error-dot hidden absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 bg-red-600 rounded-full">
                                        </span>
                                    </div>
                                </div>
                                <!-- OT -->
                                <div>
                                    <label
                                        class="block text-center text-xs font-bold text-slate-800 mb-0.5">
                                        OT
                                    </label>
                                    <div class="relative">
                                        <input
                                            type="number"
                                            step="any"
                                            inputmode="decimal"
                                            name="data[<%= row %>][OT]"
                                            data-row="<%= row %>"
                                            data-field="OT"
                                            autocomplete="off"
                                            value="<%= currentShiftData[row]?.OT ?? '' %>"
                                            class="qc-input w-full h-11 text-center text-lg rounded-xl bg-qcInputBg border border-slate-300 font-extrabold text-slate-900 focus:outline-none focus:ring-2 focus:ring-qcGreen transition-colors">
                                        <span
                                            class="qc-error-dot hidden absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 bg-red-600 rounded-full">
                                        </span>
                                    </div>
                                </div>
                                <% if (!isTPH) { %>
                                    <!-- BBT -->
                                    <div>
                                        <label
                                            class="block text-center text-xs font-bold text-slate-800 mb-0.5">
                                            BBT
                                        </label>
                                        <div class="relative">
                                            <input
                                                type="number"
                                                step="any"
                                                inputmode="decimal"
                                                name="data[<%= row %>][BBT]"
                                                data-row="<%= row %>"
                                                data-field="BBT"
                                                autocomplete="off"
                                                value="<%= currentShiftData[row]?.BBT ?? '' %>"
                                                class="qc-input w-full h-11 text-center text-lg rounded-xl bg-qcInputBg border border-slate-300 font-extrabold text-slate-900 focus:outline-none focus:ring-2 focus:ring-qcGreen transition-colors">
                                            <span
                                                class="qc-error-dot hidden absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 bg-red-600 rounded-full">
                                            </span>
                                        </div>
                                    </div>

                                    <!-- N2 -->
                                    <div>
                                        <label
                                            class="block text-center text-xs font-bold text-slate-800 mb-0.5">
                                            N2
                                        </label>
                                        <div class="relative">
                                            <input
                                                type="number"
                                                step="any"
                                                inputmode="decimal"
                                                name="data[<%= row %>][N2]"
                                                data-row="<%= row %>"
                                                data-field="N2"
                                                autocomplete="off"
                                                value="<%= currentShiftData[row]?.N2 ?? '' %>"
                                                class="qc-input w-full h-11 text-center text-lg rounded-xl bg-qcInputBg border border-slate-300 font-extrabold text-slate-900 focus:outline-none focus:ring-2 focus:ring-qcGreen transition-colors">
                                            <span
                                                class="qc-error-dot hidden absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 bg-red-600 rounded-full">
                                            </span>
                                        </div>
                                    </div>
                                <% } %>
                                <% if (isTPH) { %>
                                    <!-- AA* / RETEST AA -->
                                    <div>
                                        <label
                                            class="block text-center text-xs font-bold text-slate-800 mb-0.5">
                                            AA*
                                        </label>

                                        <div class="relative">
                                            <input
                                                type="number"
                                                step="any"
                                                inputmode="decimal"
                                                name="data[<%= row %>][AA_RETEST]"
                                                data-row="<%= row %>"
                                                data-field="AA_RETEST"
                                                autocomplete="off"
                                                value="<%= currentShiftData[row]?.AA_RETEST ?? '' %>"
                                                disabled
                                                class="qc-input w-full h-11 text-center text-lg rounded-xl bg-qcInputBg border border-slate-300 font-extrabold text-slate-900 focus:outline-none focus:ring-2 focus:ring-qcGreen transition-colors">

                                            <span
                                                class="qc-error-dot hidden absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 bg-red-600 rounded-full">
                                            </span>
                                        </div>
                                    </div>


                                    <!-- OT* / RETEST OT -->
                                    <div>
                                        <label
                                            class="block text-center text-xs font-bold text-slate-800 mb-0.5">
                                            OT*
                                        </label>

                                        <div class="relative">
                                            <input
                                                type="number"
                                                step="any"
                                                inputmode="decimal"
                                                name="data[<%= row %>][OT_RETEST]"
                                                data-row="<%= row %>"
                                                data-field="OT_RETEST"
                                                autocomplete="off"
                                                value="<%= currentShiftData[row]?.OT_RETEST ?? '' %>"
                                                disabled
                                                class="qc-input w-full h-11 text-center text-lg rounded-xl bg-qcInputBg border border-slate-300 font-extrabold text-slate-900 focus:outline-none focus:ring-2 focus:ring-qcGreen transition-colors">

                                            <span
                                                class="qc-error-dot hidden absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 bg-red-600 rounded-full">
                                            </span>
                                        </div>
                                    </div>

                                <% } %>
                             </div>
                        </div>
                    <% } %>
                </div>

                <!-- DESKTOP TABLE -->
                <div
                    id="desktop-table-container"
                    class="hidden md:block overflow-x-auto border border-slate-200 rounded-lg shadow-sm">
                    <table
                        class="w-full text-center border-collapse">
                        <thead>
                            <tr
                                class="bg-slate-200 text-slate-800 text-xs font-bold uppercase tracking-wider">
                                <th class="py-3 px-3 border-b border-slate-300">
                                    No
                                </th>

                                <th class="py-3 px-3 border-b border-slate-300">
                                    AA
                                </th>

                                <th class="py-3 px-3 border-b border-slate-300">
                                    OT
                                </th>

                                <% if (selectedProduct === "TPH") { %>

                                    <th class="py-3 px-3 border-b border-slate-300">
                                        AA*
                                    </th>

                                    <th class="py-3 px-3 border-b border-slate-300">
                                        OT*
                                    </th>

                                <% } else { %>

                                    <th class="py-3 px-3 border-b border-slate-300">
                                        BBT
                                    </th>

                                    <th class="py-3 px-3 border-b border-slate-300">
                                        N2
                                    </th>

                                <% } %>
                            </tr>
                        </thead>
                        <tbody class="text-sm font-bold">
                            <%
                                const formFields = selectedProduct === "TPH"
                                    ? ["AA", "OT", "AA_RETEST", "OT_RETEST"]
                                    : ["AA", "OT", "BBT", "N2"];
                            %>

                            <% for (let row = 1; row <= rowCount; row++) { %>

                                <tr class="border-b border-slate-200 hover:bg-slate-50">

                                    <td class="py-2 px-3 text-slate-500 font-mono">
                                        <%= String(row).padStart(2, "0") %>
                                    </td>

                                    <% formFields.forEach(field => { %>

                                        <%
                                            const isRetest =
                                                field === "AA_RETEST" ||
                                                field === "OT_RETEST";
                                        %>

                                        <td class="py-2 px-2">

                                            <div class="relative">

                                                <input
                                                    type="number"
                                                    step="any"
                                                    inputmode="decimal"
                                                    name="data[<%= row %>][<%= field %>]"
                                                    data-row="<%= row %>"
                                                    data-field="<%= field %>"
                                                    autocomplete="off"
                                                    value="<%= currentShiftData[row]?.[field] ?? '' %>"
                                                    <%= isRetest ? "disabled" : "" %>
                                                    class="qc-input w-full h-9 text-center rounded-lg bg-qcInputBg border border-slate-300 font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-qcGreen">

                                                <span
                                                    class="qc-error-dot hidden absolute left-2 top-1/2 -translate-y-1/2 w-2.5 h-2.5 bg-red-600 rounded-full">
                                                </span>

                                            </div>

                                        </td>

                                    <% }) %>

                                </tr>

                            <% } %>

                        </tbody>
                    </table>
                </div>
            </main>
            <!-- HIDDEN METADATA -->
            <input
                type="hidden"
                name="line"
                value="<%= selectedLine %>">
            <input
                type="hidden"
                name="date"
                value="<%= dateISO %>">
            <input
                type="hidden"
                name="product"
                value="<%= selectedProduct %>">
            <input
                type="hidden"
                name="shift"
                value="<%= currentShift %>">
            <!-- STICKY SAVE BUTTON -->
            <div
                class="fixed bottom-0 left-0 right-0 z-30 p-3 bg-white/85 backdrop-blur-sm border-t border-slate-200 flex justify-center">
                <div class="w-full max-w-md">
                    <button
                        id="saveButton"
                        type="submit"
                        class="w-full bg-qcGreen hover:bg-qcGreenHover text-white font-bold py-3 px-4 rounded-xl text-sm shadow-md transition-all active:scale-[0.99]">
                        <span id="progressText">
                            0 / <%= rowCount %> row terisi
                        </span>
                        <span>
                            [ SIMPAN SHIFT <%= currentShift %> ]
                        </span>
                    </button>
                </div>
            </div>
        </form>
    </div>
    <!-- JAVASCRIPT -->
    <script>
        /*
        * =====================================================
        * STANDARD QC
        * =====================================================
        */

        const qcStandard = {
            LM: {
                AA: {
                    min: 200,
                    max: 230
                },

                OT: {
                    min: 7,
                    max: 13
                },

                BBT: {
                    min: 6,
                    max: 12
                },

                N2: {
                    min: 0.4,
                    max: 0.6
                }
            },

            TPH: {
                AA: {
                    min: 320,
                    max: 370
                },

                OT: {
                    min: 8,
                    max: 11
                }

                // BBT dan N2 tidak memiliki standard
            }
        };


        /*
        * =====================================================
        * DATA LINE & PRODUCT
        * =====================================================
        */

        const selectedLine = "<%= selectedLine %>";

        const lineType = {
            "1": "TPH",
            "2": "TPH",
            "3": "LM",
            "4": "TPH",
            "10": "LM"
        };

        const productType = lineType[selectedLine];

        console.log("LINE:", selectedLine);
        console.log("PRODUCT TYPE:", productType);


        /*
        * =====================================================
        * ELEMENT
        * =====================================================
        */

        const inputs =
            document.querySelectorAll(".qc-input");

        const qcForm =
            document.getElementById("qcForm");

        const examinerNameInput =
            document.getElementById("examinerName");


        /*
        * =====================================================
        * VALIDASI STANDARD QC
        * =====================================================
        */

        function isOutOfStandard(field, value) {

            const standard =
                qcStandard[productType]?.[field];

            // Tidak ada standard
            if (!standard) {
                return false;
            }

            // Kosong bukan error
            if (value === "") {
                return false;
            }

            const number =
                Number(value);

            // Bukan angka
            if (Number.isNaN(number)) {
                return false;
            }

            return (
                number < standard.min ||
                number > standard.max
            );
        }


        /*
        * =====================================================
        * UPDATE RETEST STATE
        *
        * TPH:
        * AA keluar standard → AA* aktif
        * OT keluar standard → OT* aktif
        * =====================================================
        */

        function updateRetestState(row) {

            // Hanya berlaku untuk TPH
            if (productType !== "TPH") {
                return;
            }

            const aaInputs =
                document.querySelectorAll(
                    `.qc-input[data-row="${row}"][data-field="AA"]`
                );

            const otInputs =
                document.querySelectorAll(
                    `.qc-input[data-row="${row}"][data-field="OT"]`
                );

            const aaRetestInputs =
                document.querySelectorAll(
                    `.qc-input[data-row="${row}"][data-field="AA_RETEST"]`
                );

            const otRetestInputs =
                document.querySelectorAll(
                    `.qc-input[data-row="${row}"][data-field="OT_RETEST"]`
                );

            // Kalau input tidak ditemukan
            if (
                aaInputs.length === 0 ||
                otInputs.length === 0 ||
                aaRetestInputs.length === 0 ||
                otRetestInputs.length === 0
            ) {
                return;
            }

            const aaValue =
                aaInputs[0].value;

            const otValue =
                otInputs[0].value;


            // =========================
            // AA → AA*
            // =========================

            const aaOut =
                isOutOfStandard("AA", aaValue);

            aaRetestInputs.forEach(input => {

                input.disabled = !aaOut;

            });


            // =========================
            // OT → OT*
            // =========================

            const otOut =
                isOutOfStandard("OT", otValue);

            otRetestInputs.forEach(input => {

                input.disabled = !otOut;

            });
        }


        /*
        * =====================================================
        * VALIDASI TAMPILAN INPUT
        * =====================================================
        */

        function validateInput(input) {

            const value =
                input.value;

            const field =
                input.dataset.field;

            const wrapper =
                input.parentElement;

            const errorDot =
                wrapper
                    ? wrapper.querySelector(".qc-error-dot")
                    : null;

            const out =
                isOutOfStandard(field, value);


            if (out) {

                input.classList.remove(
                    "bg-qcInputBg",
                    "border-slate-300"
                );

                input.classList.add(
                    "bg-qcAlertBg",
                    "border-qcAlertBorder"
                );

                if (errorDot) {
                    errorDot.classList.remove("hidden");
                }

            } else {

                input.classList.remove(
                    "bg-qcAlertBg",
                    "border-qcAlertBorder"
                );

                input.classList.add(
                    "bg-qcInputBg",
                    "border-slate-300"
                );

                if (errorDot) {
                    errorDot.classList.add("hidden");
                }
            }


            // Update AA* / OT* untuk TPH
            if (
                productType === "TPH" &&
                (field === "AA" || field === "OT")
            ) {

                updateRetestState(
                    input.dataset.row
                );
            }
        }


        /*
        * =====================================================
        * CEK ROW LENGKAP
        * =====================================================
        */

        function isRowComplete(rowNumber) {

            const product =
                "<%= selectedProduct %>";

            const rowInputs =
                document.querySelectorAll(
                    `[data-row="${rowNumber}"]`
                );

            const values = {};


            rowInputs.forEach(input => {

                const field =
                    input.dataset.field;

                if (!field) {
                    return;
                }

                /*
                * Ambil nilai pertama yang tidak kosong.
                * Karena mobile dan desktop memiliki
                * input yang sama.
                */

                if (
                    values[field] === undefined &&
                    input.value.trim() !== ""
                ) {

                    values[field] =
                        input.value.trim();
                }

            });


            /*
            * =================================================
            * TPH
            *
            * Row selesai jika:
            * AA + OT
            *
            * AA* / OT* tidak dihitung
            * =================================================
            */

            if (product === "TPH") {

                return (
                    values.AA !== undefined &&
                    values.AA !== "" &&

                    values.OT !== undefined &&
                    values.OT !== ""
                );
            }


            /*
            * =================================================
            * LM
            *
            * Row selesai jika:
            * AA + OT + BBT + N2
            * =================================================
            */

            return (
                values.AA !== undefined &&
                values.AA !== "" &&

                values.OT !== undefined &&
                values.OT !== "" &&

                values.BBT !== undefined &&
                values.BBT !== "" &&

                values.N2 !== undefined &&
                values.N2 !== ""
            );
        }


        /*
        * =====================================================
        * UPDATE SEQUENTIAL ROW
        * =====================================================
        */

        function updateSequentialRows() {

            let previousRowComplete = true;

            const rowCount =
                Number("<%= rowCount %>");


            for (
                let rowNumber = 1;
                rowNumber <= rowCount;
                rowNumber++
            ) {

                const rowInputs =
                    document.querySelectorAll(
                        `[data-row="${rowNumber}"]`
                    );


                if (rowInputs.length === 0) {
                    continue;
                }


                /*
                * Row pertama selalu boleh diisi.
                *
                * Row berikutnya hanya boleh diisi
                * jika row sebelumnya sudah lengkap.
                */

                const canEdit =
                    previousRowComplete;


                const rowCard =
                    document.querySelector(
                        `[data-row-card="${rowNumber}"]`
                    );


                if (rowCard) {

                    rowCard.classList.toggle(
                        "opacity-70",
                        !canEdit
                    );

                    rowCard.classList.toggle(
                        "cursor-pointer",
                        !canEdit
                    );
                }


                rowInputs.forEach(input => {

                    const field =
                        input.dataset.field;


                    /*
                    * Retest TPH memiliki logic disabled
                    * sendiri.
                    *
                    * Jangan diubah oleh sequential system.
                    */

                    if (
                        field === "AA_RETEST" ||
                        field === "OT_RETEST"
                    ) {
                        return;
                    }


                    input.disabled =
                        !canEdit;

                });


                /*
                * Tentukan apakah row ini sudah lengkap.
                */

                const complete =
                    isRowComplete(rowNumber);

                previousRowComplete =
                    complete;
            }


            updateProgress();
        }


        /*
        * =====================================================
        * UPDATE PROGRESS
        * =====================================================
        */

        function updateProgress() {

            const rowCount =
                Number("<%= rowCount %>");

            let completedRows = 0;


            for (
                let row = 1;
                row <= rowCount;
                row++
            ) {

                if (isRowComplete(row)) {
                    completedRows++;
                }
            }


            const progressText =
                document.getElementById("progressText");


            if (progressText) {

                progressText.textContent =
                    `${completedRows} / ${rowCount} row terisi`;
            }
        }


        /*
        * =====================================================
        * ALERT ROW TERKUNCI
        * =====================================================
        */

        function showRowAlert(rowNumber, previousRow) {

            const card =
                document.querySelector(
                    `[data-row-card="${rowNumber}"]`
                );


            if (!card) {
                return;
            }


            const alert =
                card.querySelector(".row-alert");


            if (!alert) {
                return;
            }


            alert.textContent =
                `⚠️ Isi Row ${String(previousRow).padStart(2, "0")} terlebih dahulu.`;

            alert.classList.remove("hidden");


            card.classList.add(
                "border-amber-400",
                "ring-2",
                "ring-amber-200"
            );


            setTimeout(() => {

                alert.classList.add("hidden");

                card.classList.remove(
                    "border-amber-400",
                    "ring-2",
                    "ring-amber-200"
                );

            }, 2500);
        }


        /*
        * =====================================================
        * CLICK ROW TERKUNCI
        * =====================================================
        */

        document
            .querySelectorAll(".qc-row-card")
            .forEach(card => {

                card.addEventListener(
                    "click",
                    function (event) {

                        const rowNumber =
                            Number(this.dataset.rowCard);


                        // Cari row pertama yang belum lengkap
                        let previousIncompleteRow =
                            null;


                        for (
                            let row = 1;
                            row < rowNumber;
                            row++
                        ) {

                            if (!isRowComplete(row)) {

                                previousIncompleteRow =
                                    row;

                                break;
                            }
                        }


                        /*
                        * Kalau semua row sebelumnya
                        * sudah lengkap, row boleh diisi.
                        */

                        if (
                            previousIncompleteRow === null
                        ) {
                            return;
                        }


                        /*
                        * Kalau klik input yang aktif,
                        * jangan tampilkan alert.
                        */

                        const clickedInput =
                            event.target.closest(".qc-input");


                        if (
                            clickedInput &&
                            !clickedInput.disabled
                        ) {
                            return;
                        }


                        showRowAlert(
                            rowNumber,
                            previousIncompleteRow
                        );

                    }
                );
            });


        /*
        * =====================================================
        * EVENT INPUT
        * =====================================================
        */

        inputs.forEach(input => {

            // Validasi awal
            validateInput(input);


            input.addEventListener(
                "input",
                () => {

                    validateInput(input);

                    updateSequentialRows();

                }
            );

        });


        /*
        * =====================================================
        * INITIAL STATE
        * =====================================================
        */

        updateSequentialRows();


        /*
        * =====================================================
        * NOTIFICATION SYSTEM
        *
        * Digunakan untuk:
        * - Success save
        * - Error nama pemeriksa
        *
        * Popup akan otomatis hilang setelah 3 detik.
        * =====================================================
        */

        function showNotification({
            type = "success",
            title = "",
            message = ""
        }) {

            /*
            * Hapus notification lama
            * supaya tidak menumpuk.
            */

            const oldNotification =
                document.getElementById(
                    "qcNotification"
                );


            if (oldNotification) {
                oldNotification.remove();
            }


            const isError =
                type === "error";


            const notification =
                document.createElement("div");


            notification.id =
                "qcNotification";


            notification.className = `
                fixed top-5 right-5 z-[9999]
                w-[calc(100%-2rem)] max-w-sm
                flex items-start gap-3 p-4
                bg-white
                border ${isError
                    ? "border-red-200"
                    : "border-emerald-200"}
                rounded-2xl
                shadow-2xl
                transform translate-x-0 opacity-100
                transition-all duration-500
            `;


            notification.innerHTML = `

                <!-- ICON -->

                <div class="flex-shrink-0">

                    <div class="
                        w-9 h-9 rounded-full
                        ${isError
                            ? "bg-red-100"
                            : "bg-emerald-100"}
                        flex items-center justify-center
                    ">

                        ${
                            isError

                            ? `
                                <svg
                                    class="w-5 h-5 text-red-600"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2.5"
                                        d="M6 18L18 6M6 6l12 12"
                                    />
                                </svg>
                            `

                            : `
                                <svg
                                    class="w-5 h-5 text-emerald-600"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2.5"
                                        d="M5 13l4 4L19 7"
                                    />
                                </svg>
                            `
                        }

                    </div>

                </div>


                <!-- TEXT -->

                <div class="flex-1 min-w-0">

                    <p class="
                        text-sm font-bold
                        ${isError
                            ? "text-red-800"
                            : "text-emerald-800"}
                    ">
                        ${title}
                    </p>

                    <p class="text-xs text-slate-500 mt-0.5">
                        ${message}
                    </p>

                </div>


                <!-- CLOSE -->

                <button
                    type="button"
                    class="
                        flex-shrink-0
                        text-slate-400
                        hover:text-slate-600
                        transition-colors
                    "
                    aria-label="Tutup notifikasi"
                >

                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M6 6l12 12M18 6L6 18"
                        />
                    </svg>

                </button>
            `;


            document.body.appendChild(
                notification
            );


            /*
            * Tombol close
            */

            const closeButton =
                notification.querySelector("button");


            if (closeButton) {

                closeButton.addEventListener(
                    "click",
                    closeNotification
                );
            }


            /*
            * Auto hide setelah 3 detik
            */

            setTimeout(() => {

                closeNotification();

            }, 3000);
        }


        /*
        * =====================================================
        * CLOSE NOTIFICATION
        * =====================================================
        */

        function closeNotification() {

            const notification =
                document.getElementById(
                    "qcNotification"
                );


            if (!notification) {
                return;
            }


            notification.classList.remove(
                "translate-x-0",
                "opacity-100"
            );


            notification.classList.add(
                "translate-x-full",
                "opacity-0"
            );


            setTimeout(() => {

                if (notification) {
                    notification.remove();
                }

            }, 500);
        }


        /*
        * =====================================================
        * NOTIFICATION SAVE DARI SERVER
        *
        * HANYA muncul kalau saved === true.
        *
        * Jadi ketika pertama kali membuka form
        * dan belum ada data yang disimpan,
        * popup TIDAK akan muncul.
        * =====================================================
        */

        const saveStatus =
            <%= saved ? "true" : "false" %>;


        if (saveStatus) {

            showNotification({

                type: "success",

                title:
                    "Data berhasil disimpan",

                message:
                    "Data QC Shift <%= currentShift %> berhasil disimpan."

            });
        }


        /*
        * =====================================================
        * SUBMIT FORM
        * =====================================================
        */

        qcForm.addEventListener(
            "submit",
            function (event) {

                /*
                * =============================================
                * 1. CEK NAMA PEMERIKSA
                * =============================================
                */

                const examinerName =
                    examinerNameInput
                        ? examinerNameInput.value.trim()
                        : "";


                /*
                * Nama pemeriksa kosong
                */

                if (!examinerName) {

                    /*
                    * Hentikan submit.
                    */

                    event.preventDefault();


                    /*
                    * Fokus ke input pemeriksa.
                    */

                    if (examinerNameInput) {

                        examinerNameInput.focus();

                        examinerNameInput.classList.add(
                            "ring-2",
                            "ring-red-300",
                            "border-red-400"
                        );


                        /*
                        * Hilangkan highlight setelah
                        * 2.5 detik.
                        */

                        setTimeout(() => {

                            examinerNameInput.classList.remove(
                                "ring-2",
                                "ring-red-300",
                                "border-red-400"
                            );

                        }, 2500);
                    }


                    /*
                    * Popup error dengan desain
                    * SAMA seperti popup save.
                    */

                    showNotification({

                        type: "error",

                        title:
                            "Nama pemeriksa belum diisi",

                        message:
                            "Silakan isi nama pemeriksa terlebih dahulu sebelum menyimpan data."

                    });


                    return;
                }


                /*
                * =============================================
                * 2. PASTIKAN HANYA INPUT YANG TERLIHAT
                *    YANG DI-SUBMIT
                * =============================================
                */

                const isMobile =
                    window.matchMedia(
                        "(max-width: 767px)"
                    ).matches;


                const mobileContainer =
                    document.getElementById(
                        "mobile-card-container"
                    );


                const desktopContainer =
                    document.getElementById(
                        "desktop-table-container"
                    );


                if (isMobile) {

                    /*
                    * HP:
                    * Aktifkan input mobile.
                    */

                    mobileContainer
                        .querySelectorAll("input")
                        .forEach(input => {

                            input.disabled = false;

                        });


                    /*
                    * Nonaktifkan desktop.
                    */

                    desktopContainer
                        .querySelectorAll("input")
                        .forEach(input => {

                            input.disabled = true;

                        });

                } else {

                    /*
                    * Desktop:
                    * Nonaktifkan mobile.
                    */

                    mobileContainer
                        .querySelectorAll("input")
                        .forEach(input => {

                            input.disabled = true;

                        });


                    /*
                    * Aktifkan desktop.
                    */

                    desktopContainer
                        .querySelectorAll("input")
                        .forEach(input => {

                            input.disabled = false;

                        });
                }


                console.log(
                    "Examiner sebelum submit:",
                    examinerName
                );

            }
        );

    </script>

</body>

</html>