<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QC Digital - Login</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              qcGreen: '#178b8e',
              qcGreenHover: '#137477',
            }
          }
        }
      }
    </script>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex items-center justify-center p-4">

    <!-- Container Utama (Fasilitas Responsif Lebar) -->
    <div class="w-full max-w-sm sm:max-w-md md:max-w-xl lg:max-w-2xl transition-all duration-300">
        
        <!-- Card Login (Padding Menyesuaikan Layar) -->
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-700/20 p-6 sm:p-8 md:p-12">
            
            <!-- Header & Logo (Ukuran Logo & Teks Responsif) -->
            <div class="text-center mb-6 md:mb-8">
                <!-- Tag Image Logo Perusahaan -->
                <img 
                    src="https://images.seeklogo.com/logo-png/20/1/mayora-logo-png_seeklogo-203730.png" 
                    alt="Logo Perusahaan" 
                    class="h-12 sm:h-16 md:h-20 mx-auto mb-3 object-contain transition-all"
                >
                
                <h1 class="text-xl sm:text-2xl md:text-3xl font-black text-slate-900 tracking-tight">QC Digital</h1>
                <p class="text-[11px] sm:text-xs md:text-sm font-bold text-slate-500 uppercase tracking-wider mt-1">Sistem Input QC Harian</p>
            </div>

            <!-- Form Login -->
            <form action="/login" method="POST" class="space-y-4 md:space-y-6">
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl p-3 text-xs sm:text-sm font-semibold flex items-center gap-2">
                        <svg class="w-4 h-4 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <!-- Input Username / NIK -->
                <div>
                    <label for="username" class="block text-xs md:text-sm font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                        Username / NIK
                    </label>
                    <input 
                        type="text" 
                        id="username" 
                        name="username" 
                        placeholder="Masukkan ID Operator" 
                        required
                        class="w-full h-11 sm:h-12 md:h-13 px-3.5 bg-slate-50 border border-slate-300 rounded-xl text-sm md:text-base font-bold text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-qcGreen focus:border-qcGreen focus:bg-white transition-colors"
                    >
                </div>

                <!-- Input Password -->
                <div>
                    <label for="password" class="block text-xs md:text-sm font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                        Password
                    </label>
                    <input 
                        type="password" 
                        id="password" 
                        name="password" 
                        placeholder="••••••••" 
                        required
                        class="w-full h-11 sm:h-12 md:h-13 px-3.5 bg-slate-50 border border-slate-300 rounded-xl text-sm md:text-base font-bold text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-qcGreen focus:border-qcGreen focus:bg-white transition-colors"
                    >
                </div>

                <!-- Tombol Submit -->
                <div class="pt-2">
                    <button 
                        type="submit" 
                        class="w-full h-11 sm:h-12 md:h-13 bg-qcGreen hover:bg-qcGreenHover active:scale-[0.99] text-white font-bold rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center text-sm md:text-base tracking-wide"
                    >
                        Masuk Sistem
                    </button>
                </div>

            </form>

            <!-- Footer Card Info -->
            <div class="mt-6 md:mt-8 border-t border-slate-100 pt-4 text-center">
                <p class="text-[10px] sm:text-[11px] md:text-xs text-slate-400 font-mono">
                    2026
                </p>
            </div>

        </div>

    </div>

</body>
</html>