<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QC Digital - Login</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex items-center justify-center p-4">

    <!-- Container Utama -->
    <div class="">
        
        <!-- Card Login -->
        <div class="bg-white rounded-2xl shadow-xl border border-slate-800/10 p-6 sm:p-8 w-full max-w-sm sm:max-w-md mx-auto">
            
            <!-- Header & Logo -->
            <div class="text-center mb-6">
                <!-- Tag Image Logo Perusahaan -->
                <img src="https://images.seeklogo.com/logo-png/20/1/mayora-logo-png_seeklogo-203730.png" alt="Logo Perusahaan" class="h-20 mx-auto mb-3 object-contain">
                
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">QC Digital</h1>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1">Sistem Input QC Harian</p>
            </div>

            <!-- Form Login -->
            <form action="/login" method="POST" class="space-y-4">
                <% if (error) { %>
                    <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg p-3 text-sm font-semibold">
                        <%= error %>
                    </div>
                <% } %>
                <!-- Input Username / NIK -->
                <div>
                    <label for="username" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                        Username / NIK
                    </label>
                    <input 
                        type="text" 
                        id="username" 
                        name="username" 
                        placeholder="Masukkan ID Operator" 
                        required
                        class="w-full h-12 px-3.5 bg-slate-50 border border-slate-300 rounded-lg text-sm font-semibold text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:bg-white transition-colors"
                    >
                </div>

                <!-- Input Password -->
                <div>
                    <label for="password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                        Password
                    </label>
                    <input 
                        type="password" 
                        id="password" 
                        name="password" 
                        placeholder="••••••••" 
                        required
                        class="w-full h-12 px-3.5 bg-slate-50 border border-slate-300 rounded-lg text-sm font-semibold text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:bg-white transition-colors"
                    >
                </div>

                <!-- Tombol Submit -->
                <div class="pt-2">
                    <button 
                        type="submit" 
                        class="w-full h-12 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-bold rounded-lg shadow-md hover:shadow transition-all flex items-center justify-center text-sm"
                    >
                        Masuk Sistem
                    </button>
                </div>

            </form>

            <!-- Footer Card Info -->
            <div class="mt-6 border-t border-slate-100 pt-4 text-center">
                <p class="text-[11px] text-slate-400 font-mono">
                    Testing
                </p>
            </div>

        </div>

    </div>

</body>
</html>